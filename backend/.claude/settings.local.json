{
  "permissions": {
    "allow": [
      "Bash(./venv/Scripts/python.exe --version)",
      "Bash(./venv/Scripts/python.exe -m pip list)",
      "Bash(./venv/Scripts/python.exe -c \"import json;print\\(json.load\\(open\\('serviceAccountKey.json'\\)\\)['project_id']\\)\")",
      "Bash(./venv/Scripts/python.exe *)",
      "Bash(curl -s http://127.0.0.1:8000/)",
      "Bash(curl -s http://127.0.0.1:8000/health)",
      "Bash(curl -s -o /dev/null -w \"docs HTTP %{http_code}\\\\n\" http://127.0.0.1:8000/docs)",
      "Bash(curl -s -w \" [%{http_code}]\\\\n\" http://127.0.0.1:8000/api/hospitals)",
      "Bash(curl -s -w \" [%{http_code}]\\\\n\" -H \"Authorization: Bearer faketoken\" http://127.0.0.1:8000/api/me)",
      "Bash(curl -s -w \" [%{http_code}]\\\\n\" -X POST http://127.0.0.1:8000/api/chatbot/query)",
      "Bash(curl -s -o /dev/null -w \"server still up: %{http_code}\\\\n\" http://127.0.0.1:8000/health)",
      "Bash(powershell.exe -Command 'Get-NetTCPConnection -LocalPort 8000 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force }')",
      "Bash(curl -s -o /dev/null -w \"port 8000: %{http_code}\\\\n\" http://127.0.0.1:8000/health)"
    ]
  }
}
