# ---- Firebase web API key ----------------------------------------------------
# Same key the admin panel uses (admin-panel/.env.local -> VITE_FIREBASE_API_KEY).
# Used to sign users in via the Firebase Auth REST API (email/password).
FIREBASE_API_KEY=your_web_api_key_here

# Firebase project id (admin-panel uses hospital-queue-managemen-67208).
FIREBASE_PROJECT_ID=your_project_id

# ---- Service account (Admin SDK) --------------------------------------------
# Download from: Firebase Console > Project settings > Service accounts >
# "Generate new private key". Save the JSON and point this at it.
# Not required when running against the emulator (see below).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ---- Firebase emulator (local dev) ------------------------------------------
# Set both to route Auth + Firestore to the local Firebase Emulator Suite
# (firebase.json: Auth 9099, Firestore 8020). While set, no service-account key
# is needed and ID tokens issued by the emulator are trusted. Leave blank/unset
# to use production Firebase.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8020
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Misc -------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (admin dev server, Flutter web).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Fallback per-patient service time (minutes) used before enough history exists.
DEFAULT_SERVICE_MINUTES=10

# ---- Email OTP (registration verification) ----------------------------------
# Gmail: create an App Password (Google Account > Security > 2-Step Verification
# > App passwords) and use your Gmail address as SMTP_USER and the 16-char app
# password as SMTP_PASS. Leave blank to run OTP in dev mode (code is logged and
# returned in the API response instead of emailed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your_gmail_address@gmail.com
OTP_TTL_MINUTES=10

# ---- Chatbot (Gemini) -------------------------------------------------------
# Google AI Studio API key (https://aistudio.google.com/apikey). Powers the
# in-process assistant via Chatbot/bot.py. Blank = canned fallback replies.
GEMINI_API_KEY=your_gemini_api_key
